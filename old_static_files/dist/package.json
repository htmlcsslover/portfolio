{
  "name": "raphael-portfolio",
  "version": "1.0.0",
  "description": "High-performance portfolio with optimized Tailwind CSS",
  "type": "module",
  "scripts": {
    "dev": "tailwindcss -i ./src/css/input.css -o ./dist/styles.css --watch",
    "build": "NODE_ENV=production tailwindcss -i ./src/css/input.css -o ./dist/styles.css --minify",
    "build:full": "npm run build && npm run optimize:images",
    "optimize:images": "node scripts/optimize-images.js",
    "serve": "http-server ./dist -p 8080 -c-1",
    "preview": "npm run build && npm run serve",
    "lint:css": "stylelint src/css/**/*.css",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "http-server": "^14.1.1",
    "postcss": "^8.4.31",
    "postcss-import": "^15.1.0",
    "prettier": "^3.1.0",
    "stylelint": "^16.0.2",
    "stylelint-config-standard": "^35.0.0",
    "tailwindcss": "^3.3.6"
  },
  "dependencies": {
    "intersection-observer": "^0.12.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
